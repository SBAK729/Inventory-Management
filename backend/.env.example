# --- Database (Neon) ---------------------------------------------------
# In the Neon console: Project -> Connect -> copy the connection string.
# Used both by the Prisma CLI (via prisma.config.ts) and by the running app
# (via the PrismaNeon driver adapter in src/prisma/prisma.service.ts).
# Prisma 7+ no longer supports a separate `directUrl` — one URL for both.
DATABASE_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# --- Auth ----------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# --- App -------------------------------------------------------------------
PORT=3000
